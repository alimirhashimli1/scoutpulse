# Copy to .env, then run `make keys` to generate the JWT key pair.
# .env is gitignored; never commit real secrets.

# --- JWT ---------------------------------------------------------------
# Generated by `make keys`. identity-svc signs with the private key and is the
# only service given it; every other service verifies with the public key and
# therefore cannot mint tokens of its own.
#
# To generate by hand:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -in private.pem -pubout -out public.pem
#
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"
#
# Alternative to JWT_PUBLIC_KEY for verifying services: point them at the
# issuer's JWKS document instead of pinning a key. Preferred, because the key
# set is then polled and a rotation propagates without a redeploy. Must be
# https unless the host is loopback or an in-cluster service name.
# JWKS_URL=http://identity-svc:8080/.well-known/jwks.json

# --- Database ----------------------------------------------------------
# One Postgres instance, one database and login role per service.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=postgres

IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=password

FOOTBALL_DB_USER=football_user
FOOTBALL_DB_PASSWORD=password

# Connection pool, per service. MaxOpenConns must leave headroom under
# Postgres's max_connections (100 by default) across every service that
# connects to it.
# DB_MAX_OPEN_CONNS=25
# DB_MAX_IDLE_CONNS=25
# DB_CONN_MAX_LIFETIME=30m
# DB_CONN_MAX_IDLE_TIME=5m

# TLS to the database. "disable" suits the compose network, where traffic never
# leaves the bridge; use "require" or "verify-full" anywhere else.
# DB_SSLMODE=disable

# --- Events ------------------------------------------------------------
# Set by docker-compose for football-svc. With this unset, or with the broker
# unreachable, services run with events disabled rather than failing to start.
# NATS_URL=nats://nats:4222

# --- HTTP --------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
#
# There is no default: leaving this unset denies every cross-origin request
# rather than allowing all of them. Use "*" to allow any origin, explicitly.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Observability -----------------------------------------------------
# Tracing is disabled when this is unset. With the observability profile
# running, point it at Jaeger:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Fraction of traces to sample, 0.0 to 1.0. Defaults to 1.0 (everything).
OTEL_TRACES_SAMPLER_ARG=1.0
