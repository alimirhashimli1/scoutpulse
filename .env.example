# Copy to .env and fill in before running `make up`.
# .env is gitignored; never commit real secrets.

# Signing key for JWTs. Both services must use the same value: identity-svc
# signs tokens, football-svc verifies them. Minimum 32 characters -- the
# services refuse to start with anything shorter.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-characters

# Postgres credentials, shared by the databases and the services.
DB_USER=user
DB_PASSWORD=password

# Comma-separated origins allowed to call the APIs from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:4200
