# API gateway.
#
# Without this, the frontend has to know a port per service -- 8080, 8081, and
# then 8082, 8083 as apps are added. Everything now enters on one origin and is
# routed by path prefix, so adding a service is a block here and no frontend
# change at all.
#
# It is also where TLS terminates and where the correlation id is assigned.
#
# Rate limiting is deliberately *not* here: Caddy's rate-limit module is a
# third-party plugin absent from the official image, so a limit configured here
# would only exist for whoever remembers to build a custom gateway. It lives in
# libs/platform/server instead, applied by the service that owns the endpoint --
# see identity-svc's credential routes.
{
    admin off
}

# Upstreams differ by host only in their suffix. Compose resolves a bare
# service name; Railway's private network wants `<service>.railway.internal`.
# Hardcoding either one breaks the other -- and it breaks it as a 502 from a
# gateway that looks perfectly healthy, which is a slow thing to diagnose.
#
# Empty by default, so `docker compose up` needs no extra configuration. Set
# INTERNAL_SUFFIX=.railway.internal on Railway.

:{$PORT:8000} {
    # Well-known JWKS routing
    handle /.well-known/jwks.json {
        reverse_proxy identity-svc{$INTERNAL_SUFFIX}:8080
    }

    # Identity service API
    handle_path /api/identity/* {
        reverse_proxy identity-svc{$INTERNAL_SUFFIX}:8080
    }

    # Football service API
    handle_path /api/football/* {
        reverse_proxy football-svc{$INTERNAL_SUFFIX}:8081
    }

    # Frontend SSR catch-all
    handle {
        reverse_proxy frontend{$INTERNAL_SUFFIX}:4000
    }
}